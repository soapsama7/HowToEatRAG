<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.anfioo</groupId>
		<artifactId>howtocook</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>

	<artifactId>howtocook-common</artifactId>
	<name>howtocook-common</name>
	<description>公共库：实体 / Mapper / 存储 / 解析分块 / 向量化 / 检索等底层能力（纯 jar，不可运行）</description>

	<dependencies>
		<!-- MyBatis-Plus（含 MyBatis / Spring JDBC） -->
		<dependency>
			<groupId>com.baomidou</groupId>
			<artifactId>mybatis-plus-spring-boot3-starter</artifactId>
		</dependency>
		<!-- JSON：公共 Jackson 配置（含 jackson-datatype-jsr310，LocalDateTime 序列化） -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-json</artifactId>
		</dependency>
		<!-- Redis（公共 Redis 配置与 RedisTemplate 在本模块） -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis</artifactId>
		</dependency>
		<!-- pgvector：vector 类型 TypeHandler -->
		<dependency>
			<groupId>com.pgvector</groupId>
			<artifactId>pgvector</artifactId>
		</dependency>
		<!-- AWS S3 SDK v2：连 RustFS -->
		<dependency>
			<groupId>software.amazon.awssdk</groupId>
			<artifactId>s3</artifactId>
		</dependency>
		<!-- Markdown AST 解析 -->
		<dependency>
			<groupId>org.commonmark</groupId>
			<artifactId>commonmark</artifactId>
		</dependency>
		<!-- Lombok -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
	</dependencies>
</project>
