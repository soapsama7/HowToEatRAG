# =====================================================================
# docker compose 环境变量模板（进 git）
# 用法：cp .env.example .env  →  在 .env 中填真实值（.env 已 gitignore，不进仓库）
# =====================================================================

# ---------------- PostgreSQL ----------------
PG_DATABASE=howtocook
PG_USER=postgres
PG_PASSWORD=                          # 必填：数据库密码（同时是 spring.datasource.password 的来源）

# ---------------- RustFS（S3 兼容对象存储） ----------------
RUSTFS_ACCESS_KEY=                    # 必填：S3 Access Key（建议 16 位以上）
RUSTFS_SECRET_KEY=                    # 必填：S3 Secret Key（建议 32 位以上）
RUSTFS_BUCKET=howtocook               # 桶名（Step 2.1 启动时自动创建）
RUSTFS_ENDPOINT=http://localhost:9000 # 主应用（宿主侧）访问地址；容器内为 http://rustfs:9000

# ---------------- MCP Tool Server 内部预共享 Token ----------------
MCP_INTERNAL_TOKEN=                   # 必填（Step 3.2 使用）：主应用调 MCP Server 的 X-Internal-Token

# ---------------- 管理员账号 ----------------
ADMIN_PASSWORD=                       # 可选：admin 账号初始密码；缺省为 admin@12345 并在启动日志警告，生产必须设置

# ---------------- 可选端口（默认与 docker-compose.yml 一致，一般不需改） ----------------
# PG_PORT=5432
# REDIS_PORT=6379
# RUSTFS_PORT=9000
# RUSTFS_CONSOLE_PORT=9001
