<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.anfioo</groupId>
		<artifactId>howtocook</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>

	<artifactId>howtocook-mcp-server</artifactId>
	<name>howtocook-mcp-server</name>
	<description>MCP Tool Server：search_chunks / get_recipe_detail（独立部署，仅 docker 内网可达）</description>

	<dependencies>
		<!-- 内部公共库：检索 / 存储等底层能力复用 -->
		<dependency>
			<groupId>com.anfioo</groupId>
			<artifactId>howtocook-common</artifactId>
		</dependency>

		<!-- Spring AI MCP Server（WebMVC，SSE 传输） -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
		</dependency>

		<!-- Spring AI OpenAI 协议客户端：search_chunks 检索前需将 query 向量化（EmbeddingModel） -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-model-openai</artifactId>
		</dependency>

		<!-- Actuator：健康检查（compose healthcheck 与鉴权白名单使用） -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!-- PostgreSQL 驱动（检索直连 PG） -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Lombok -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- 测试 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
